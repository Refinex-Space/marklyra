{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": [
      "packages/**",
      "apps/**",
      "tests/**",
      "scripts/**",
      "!**/dist",
      "!**/src-tauri",
      "!**/artifacts",
      "!packages/editor-runtime/src/page",
      "!packages/editor-runtime/assets",
      "!packages/editor-runtime/vendor",
      "!packages/editor-themes/assets",
      "!packages/editor-themes/base.css",
      "!apps/desktop/src/features/settings/runtime-preferences/page"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "a11y": {
        "noAutofocus": "off"
      },
      "style": {
        "noNonNullAssertion": "error"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "overrides": [
    {
      "includes": ["packages/editor-runtime/src/engine/**"],
      "linter": {
        "rules": {
          "recommended": false,
          "correctness": {
            "noUnreachable": "error"
          },
          "suspicious": {
            "noDebugger": "error",
            "noDuplicateCase": "error",
            "noDuplicateClassMembers": "error",
            "noDuplicateParameters": "error"
          }
        }
      },
      "assist": { "enabled": false }
    }
  ]
}
