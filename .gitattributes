# Keep authored code and configuration consistent across Windows and macOS.
*.ts text eol=lf
*.tsx text eol=lf
*.mts text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.rs text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.css text eol=lf
*.html text eol=lf

# Keep the two authoritative notice files byte-exact on all hosts.
LICENSE -text -whitespace
THIRD-PARTY-NOTICES.txt -text -whitespace

# Editor sources contain pinned bytes; do not apply Windows CRLF conversion.
packages/editor-runtime/src/engine/** -text -whitespace
packages/editor-runtime/src/page/** -text -whitespace
packages/editor-runtime/assets/** -text -whitespace
packages/editor-runtime/vendor/** -text -whitespace
packages/editor-themes/assets/** -text -whitespace
packages/editor-themes/base.css -text -whitespace
apps/desktop/src/features/settings/runtime-preferences/page/** -text -whitespace
apps/desktop/src-tauri/icons/titlebar/** -text -whitespace
apps/desktop/public/icons/** -text -whitespace
**/test-fixtures/** -text -whitespace

# Dependency inventory hashes must match on Windows and macOS.
pnpm-lock.yaml text eol=lf
Cargo.lock text eol=lf
